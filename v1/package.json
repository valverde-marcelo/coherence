{
  "name": "coherence",
  "version": "1.0.0",
  "description": "Distributed P2P social network - Hyperswarm/Corestore/Hyperbee core + Electron interface",
  "main": "main.js",
  "private": true,
  "license": "Apache-2.0",
  "author": "Marcelo Valverde",
  "repository": {
    "type": "git",
    "url": "https://github.com/valverde-marcelo/coherence.git"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "start-all": "node scripts/start-all.js",
    "new-user": "electron . --new-user",
    "reset": "node scripts/reset.js",
    "reset-all": "node scripts/reset.js --all",
    "make-icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --dir",
    "test": "node test/test-posts-and-unfollow.js && node test/test-integration-follow-sync.js && node test/test-follow-target.js && node test/test-user-social.js && node test/test-search-transitive.js && node test/test-integration-seeding.js && node test/test-persistence.js && node test/test-restart-after-stop-race.js && node test/test-identity-recovery.js && node test/test-recovery-timeout.js && node test/test-import-cancel-no-corestore.js && node test/test-legacy-migration.js"
  },
  "build": {
    "appId": "dev.coherence.app",
    "productName": "Coherence",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "picker-preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/rocksdb-native/**",
      "**/node_modules/udx-native/**",
      "**/node_modules/sodium-native/**",
      "**/node_modules/quickbit-native/**",
      "**/node_modules/simdle-native/**",
      "**/node_modules/fs-native-extensions/**",
      "**/node_modules/device-file/**",
      "**/node_modules/blind-relay/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Coherence",
      "artifactName": "Coherence-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Coherence-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "corestore": "^7.11.1",
    "hyperbee": "^2.27.3",
    "hypercore": "^11.35.0",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
